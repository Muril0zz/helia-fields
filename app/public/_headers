/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self' blob:; child-src blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://gibs.earthdata.nasa.gov https://tiles.maps.eox.at https://s3.amazonaws.com; connect-src 'self' https://power.larc.nasa.gov https://modis.ornl.gov https://modisrest.ornl.gov https://rest.isric.org https://gibs.earthdata.nasa.gov https://tiles.maps.eox.at https://s3.amazonaws.com https://geoserver.car.gov.br https://terrabrasilis.dpi.inpe.br https://cmr.earthdata.nasa.gov https://api.open-meteo.com https://nominatim.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'

/demo/*
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable
